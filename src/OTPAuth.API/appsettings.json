{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Otp": {
    "Length": 6,
    "TtlMinutes": 3,
    "FlowTtlMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxResends": 3
  },
  "Jwt": {
    "Issuer": "OTPAuth.API",
    "Audience": "OTPAuth.Client",
    "ExpirationMinutes": 15
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "VerifyOtp": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ResendOtp": {
      "PermitLimit": 3,
      "WindowSeconds": 300
    }
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "FromEmail": "",
    "FromName": "OTP Authentication System",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
